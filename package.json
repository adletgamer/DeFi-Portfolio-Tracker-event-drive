{
  "name": "defi-portfolio-tracker",
  "version": "0.1.0",
  "description": "Event-driven, serverless DeFi portfolio tracker: a scheduled poller reads on-chain events for watched wallets over HTTPS RPC, enqueues them, a normalizer writes them to DynamoDB, and an HTTP API serves the results.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "defi-portfolio-tracker": "infra/cdk/bin/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:cdk": "tsc -p infra/cdk/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "bootstrap": "tsx src/local/bootstrap.ts",
    "poll": "tsx src/local/run-poller.ts",
    "dev": "tsx src/local/dev.ts",
    "api": "tsx src/local/api-server.ts",
    "worker": "tsx src/local/worker.ts",
    "e2e": "tsx src/local/e2e.ts",
    "cdk": "cdk",
    "synth": "npm run build:cdk && cdk synth",
    "deploy": "npm run build:cdk && cdk deploy",
    "diff": "npm run build:cdk && cdk diff",
    "destroy": "cdk destroy"
  },
  "keywords": [
    "defi",
    "aws",
    "cdk",
    "serverless",
    "portfolio-tracker"
  ],
  "author": "AlejandraCV01",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-secrets-manager": "^3.658.0",
    "@aws-sdk/client-sqs": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "aws-cdk-lib": "^2.149.0",
    "constructs": "^10.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "aws-cdk": "^2.149.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
