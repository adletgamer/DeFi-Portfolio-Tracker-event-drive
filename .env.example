# ---------------------------------------------------------------------------
# DeFi Portfolio Tracker - local development configuration
# Copy to `.env` to override defaults. All values below are the local defaults
# used automatically when the variable is unset, so `.env` is optional.
# ---------------------------------------------------------------------------

# AWS region (any value works for the local emulators)
AWS_REGION=us-east-1

# Dummy credentials required by the AWS SDK when talking to local emulators
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Local emulator endpoints. Leave unset in real AWS so the SDK uses the
# real DynamoDB / SQS endpoints.
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
SQS_ENDPOINT=http://127.0.0.1:9324

# Resource names
TABLE_NAME=DefiEvents
QUEUE_NAME=defi-events

# Wallets to watch (comma-separated 0x addresses)
WATCHED_WALLETS=0xaAaAaAaaAaAaAaaAaAAAAAAAAaaAAAaAaaAaaAaA,0x1111111111111111111111111111111111111111

# RPC source for on-chain events.
#   mock -> deterministic synthetic events (offline, default for dev)
#   http -> real JSON-RPC endpoint (set RPC_URL)
RPC_MODE=mock
RPC_URL=https://cloudflare-eth.com

# HTTP API port
API_PORT=3000

# How often the local scheduler runs the poller (milliseconds)
POLL_INTERVAL_MS=15000
